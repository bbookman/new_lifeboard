    # Embedding Operations - Interface Definitions

    async def get_pending_embeddings(self, limit: int = 100) -> List[Dict[str, Any]]:
        """
        Get data items that need embedding asynchronously.

        Args:
            limit: Maximum number of items to return

        Returns:
